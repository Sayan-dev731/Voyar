# Backend Environment Variables

# Server Configuration
PORT=5000
NODE_ENV=production

# Database
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/voyar?retryWrites=true&w=majority

# JWT Secret (use a strong random string)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Frontend URL (for CORS and email links)
FRONTEND_URL=https://voyar.vercel.app

# Email Configuration (Gmail)
EMAIL_ID=your-email@gmail.com
EMAIL_PASSWORD=your-app-specific-password

# Note: For Gmail, you need to:
# 1. Enable 2-factor authentication on your Google account
# 2. Generate an App Password at https://myaccount.google.com/apppasswords
# 3. Use the App Password (not your regular Gmail password)

# Admin Configuration
ADMIN_USERNAME=admin
ADMIN_PASSWORD=secureAdminPassword123
ADMIN_EMAIL=admin@voyareyewear.com

# Shiprocket Integration
# Sign up at https://shiprocket.in/ to get credentials
# IMPORTANT: Create an API User in Shiprocket Dashboard -> Settings -> API -> Add New API User
SHIPROCKET_EMAIL=your-shiprocket-api-user-email@example.com
SHIPROCKET_PASSWORD=your-shiprocket-api-user-password
# Optional: Default pickup location name (must match exactly with Shiprocket dashboard)
# The pickup location must be created first in Shiprocket Dashboard -> Settings -> Pickup Addresses
SHIPROCKET_PICKUP_LOCATION=Primary
# Optional: Webhook security token for Shiprocket webhooks
SHIPROCKET_WEBHOOK_TOKEN=your-webhook-security-token
# Optional: Default pickup pincode (used for courier serviceability check)
PICKUP_PINCODE=110001
